# Multi-stage build for faster rebuilds
FROM golang:1.22.9 AS base

WORKDIR /code

# Install system dependencies in a separate layer (cached)
RUN apt-get update && apt-get install -y \
    ca-certificates fonts-liberation libappindicator3-1 \
    libasound2 libatk-bridge2.0-0 libatk1.0-0 libc6 \
    libcairo2 libcups2 libdbus-1-3 libexpat1 libfontconfig1 \
    libgbm1 libgcc1 libglib2.0-0 libgtk-3-0 libnspr4 libnss3 \
    libpango-1.0-0 libpangocairo-1.0-0 libstdc++6 libx11-6 \
    libx11-xcb1 libxcb1 libxcomposite1 libxcursor1 libxdamage1 \
    libxext6 libxfixes3 libxi6 libxrandr2 libxrender1 libxss1 \
    libxtst6 lsb-release wget xdg-utils nodejs npm && \
    rm -rf /var/lib/apt/lists/*

# Set up Playwright environment
ENV PLAYWRIGHT_BROWSERS_PATH=/root/.cache/ms-playwright

# Install Playwright and browsers in a single layer to reduce image size
# Use specific versions to ensure compatibility
RUN go install github.com/playwright-community/playwright-go/cmd/playwright@v0.4902.0 && \
    cd /tmp && \
    # Install specific npm package version for compatibility
    npm init -y && \
    npm install playwright@1.49.1 && \
    # Install Firefox with dependencies
    npx playwright@1.49.1 install firefox --with-deps && \
    # Create necessary directories and symlinks for compatibility
    mkdir -p /root/.cache/ms-playwright && \
    mkdir -p /go/pkg/mod/github.com/playwright-community && \
    ln -sf /root/.cache/ms-playwright /go/pkg/mod/github.com/playwright-community/playwright-drivers && \
    # Create firefox version symlink
    cd /root/.cache/ms-playwright && \
    if [ -d "$(find . -name 'firefox-*' -type d | head -1)" ]; then \
        mkdir -p ./firefox-1491 && \
        cp -r $(find . -name 'firefox-*' -type d | head -1)/* ./firefox-1491/ && \
        ln -sf ./firefox-* ./firefox-1491; \
    fi && \
    # Fix permissions
    chmod -R 777 /root/.cache/ms-playwright && \
    # Cleanup
    cd /code && \
    rm -rf /tmp/node_modules /tmp/package*.json

# Dependencies stage - only rebuilds when go.mod/go.sum changes
FROM base AS deps
COPY go.mod go.sum ./
RUN go mod download

# Build stage - only rebuilds when source code changes
FROM deps AS builder
COPY . .
RUN go build -o emboxd .

# Final stage
FROM deps AS final
COPY --from=builder /code/emboxd /usr/local/bin/emboxd
COPY docker-entrypoint.sh /usr/local/bin/
RUN chmod +x /usr/local/bin/docker-entrypoint.sh

# Create directories
RUN mkdir -p /logs /data /config && \
    chmod -R 755 /logs && \
    touch /logs/emboxd.log && \
    chmod 644 /logs/emboxd.log

ENTRYPOINT ["docker-entrypoint.sh"]
CMD ["-c", "/config/config.yaml"]
